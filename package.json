{
  "name": "@dsh-restart/one-click-restart",
  "version": "0.1.4",
  "description": "One-click restart for DeepSeek Harness: a model-callable tool plus a detached watchdog that relaunches the app after exit.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.13.6",
    "@types/react": "~18.3.31",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.6.0"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit"
  }
}